# ============================================
# Thor-EN-Dashboard — Environment Variables Template
# (repository: Thor-EN-Dashboard — the WEB DASHBOARD ONLY)
# ============================================
# Copy this file to .env (development) or paste the values into your
# hosting environment variables (production):
#   cp .env.example .env       (run inside the repo root)
#
# NEVER commit .env* files.
#
# SCOPE (v4.1.0 — repository split):
#   This repository is the WEB DASHBOARD ONLY (Next.js app, Discord
#   OAuth2 login, session cookies, the dashboard's own user database).
#   The Discord bot is a SEPARATE repository — Thor-EN
#   (https://github.com/dwisetyabudi15581/Thor-EN) — with its OWN
#   .env.example (DISCORD_TOKEN, GUILD_ID, DASH_API_HOST/PORT/TOKEN).
#   The ONLY values that must MATCH between the two .env files are the
#   DASH_API_* settings (the bridge between the dashboard and the bot).
# ============================================

# === DASHBOARD DATABASE (this repo only — DATABASE_URL) ===
# Two shapes, picked automatically by the scripts/build & scripts/db wrappers:
#
# 1) LOCAL / VPS (default) — SQLite: stores the dashboard's own users
#    (Discord OAuth login mapping). Relative to the repo root. NOTE: the
#    bot's server configuration does NOT live here — it stays inside the
#    Thor-EN bot repository (its data/ folder) and is reached through the
#    DASH API below, so the two can never conflict.
DATABASE_URL=file:db/custom.db
#
# 2) SERVERLESS HOSTING (Vercel — see DEPLOY-VERCEL.md) — a cloud Postgres
#    (Neon/Supabase) connection string. A SQLite FILE cannot survive on
#    serverless hosting (ephemeral filesystem — wiped on every cold start),
#    so the database must live in the cloud. Use the POOLED connection
#    string (Neon: the host ending in "-pooler") for the Vercel runtime:
#   DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#    When DATABASE_URL starts with postgres:// the build/db scripts
#    automatically switch to prisma/schema.postgres.prisma (the Postgres
#    flavour of the schema) — nothing else to configure.

# === SESSION_SECRET (dashboard only — REQUIRED in production) ===
# Signs the login session cookies. MUST be replaced with a long random
# string in production (e.g. the output of `openssl rand -hex 32`).
# A DIFFERENT secret from DASH_API_TOKEN — never reuse values.
SESSION_SECRET=replace-with-a-long-random-string

# Demo login (member & admin) — automatically disabled once DISCORD_CLIENT_ID
# is filled in; force on/off with true/false
DEMO_MODE=false

# ===== Discord OAuth2 (dashboard only — Developer Portal -> application -> OAuth2) =====
# DISCORD_CLIENT_ID is the application's Application ID (same bot app the
# token in the Thor-EN bot repository's .env belongs to). DISCORD_CLIENT_SECRET
# is the OAuth2 client secret from the same page.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# === CALLBACK_URL / redirect URI (dashboard only) ===
# The redirect URI registered in the Developer Portal is BUILT from
# PUBLIC_ORIGIN — no separate variable needed:
#   https://<PUBLIC_ORIGIN>/api/auth/discord/callback
# The dashboard shows the exact address on the login page (the "Bot owner
# setup" box); copy it from there. Fixed origin (REQUIRED in production for
# consistent OAuth redirects):
#   PUBLIC_ORIGIN=https://thor.yourdomain.com
#   On Vercel with the thormarket.site domain (see DEPLOY-VERCEL.md):
#   PUBLIC_ORIGIN=https://thormarket.site
PUBLIC_ORIGIN=

# Discord IDs (comma-separated) that automatically become dashboard admins
ADMIN_DISCORD_IDS=

# ===== Thor bot DASH API (REQUIRED — the bridge between dashboard & bot) =====
# Must be EXACTLY the same as in the Thor-EN bot repository's .env:
#   DASH_API_URL=http://127.0.0.1:8788   (bot and web on the same VPS)
#   DASH_API_TOKEN=<the-same-random-token-on-both-sides>
# When the dashboard runs on VERCEL (see DEPLOY-VERCEL.md) it can no longer
# reach 127.0.0.1 — the bot's DASH API must be exposed through a PUBLIC
# HTTPS tunnel (cloudflared on the bot's host):
#   DASH_API_URL=https://<tunnel-id>.trycloudflare.com
DASH_API_URL=http://127.0.0.1:8788
DASH_API_TOKEN=

# Bot invite link for the "Invite Thor" button (optional — has a default)
NEXT_PUBLIC_INVITE_URL=
